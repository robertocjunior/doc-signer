PORT=8080
BASE_URL=http://localhost:8080
DB_PATH=/app/data/signatures.db

# Autenticação Microsoft Entra ID (mesmas credenciais do Outline)
AZURE_TENANT_ID=common
AZURE_CLIENT_ID=seu-client-id-aqui
AZURE_CLIENT_SECRET=seu-client-secret-aqui

# Admins autorizados a ver o relatório completo em /admin (separados por vírgula)
ADMIN_EMAILS=admin@dominio.com.br

# SMTP Office 365
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=seu-email@dominio.com.br
SMTP_PASSWORD=sua-senha-aqui
SMTP_FROM_EMAIL=Assinador <seu-email@dominio.com.br>
SMTP_REPLY_EMAIL=Assinador <seu-email@dominio.com.br>
